@article{luo2026memsif,
  title           = {{MemSIF}: From Structured Interactions to Dual-Track Fact Memory for {LLM} Agents},
  author          = {Luo, Yufei and Xu, Xiucheng and Yang, Zhen},
  journal         = {arXiv preprint arXiv:2608.01742},
  year            = {2026},
  doi             = {10.48550/arXiv.2608.01742},
  arxiv           = {2608.01742},
  pdf             = {https://arxiv.org/pdf/2608.01742},
  code            = {https://github.com/luoyufeihaha/MemSIF},
  abbr            = {arXiv},
  preview         = {memsif-structured-interaction-and-dual-track-fact-memory-overview.png},
  selected        = {true},
  bibtex_show     = {true},
  note            = {<span class="publication-impact">Introduces a structured interaction-to-fact memory framework that achieves the highest Total ACC across all evaluated settings on LoCoMo and LongMemEval-S.</span>},
  abstract        = {Long-term memory is critical for LLM agents operating over long-horizon interactions, yet existing memory systems exhibit Temporal--Structural Misalignment and Delayed Utility Manifestation. MemSIF combines Structured Interaction Memory with Dual-Track Fact Memory: CoreFact consolidates stable, schema-guided information at write time, while ActiveFact forms and promotes reusable facts when their utility emerges through later queries. Across five backbone LLMs, MemSIF achieves the highest Total ACC in all evaluated settings on LoCoMo and LongMemEval-S.}
}

